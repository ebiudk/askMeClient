<UserControl x:Class="askMeWindows.Views.StatusControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="100" d:DesignWidth="800">
    <Border Background="White" CornerRadius="8" Padding="15">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- ステータス -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center" MinWidth="150">
                    <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="ステータス"/>
                    <TextBlock Style="{StaticResource ValueTextBlockStyle}" Text="{Binding Status}" Foreground="#0078D4"/>
                </StackPanel>

                <!-- ポーリング間隔 -->
                <StackPanel Grid.Column="1" Margin="30,0,0,0" VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="ポーリング間隔"/>
                    <Slider Minimum="0.1" Maximum="5" Value="{Binding PollingInterval}" />
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontSize="11" Foreground="#999999" Text="{Binding PollingInterval, StringFormat='{}{0:0.#}'}"/>
                        <TextBlock FontSize="11" Foreground="#999999" Text="秒"/>
                    </StackPanel>
                </StackPanel>

                <!-- ボタン -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                    <Button Content="開始" Command="{Binding StartCommand}" Width="70" Height="45"/>
                    <Button Content="停止" Command="{Binding StopCommand}" Background="#D13438" Width="70" Height="45"/>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
