<Window x:Class="askMeWindows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:askMeWindows.Views"
        Title="AskMe! クライアント" Height="700" Width="900"
        Icon="/logo.png"
        Background="#F5F5F5"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        IsManipulationEnabled="False"
        Stylus.IsFlicksEnabled="False">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ヘッダー -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel Orientation="Horizontal">
                <Image Source="/logo.png" Width="48" Height="48" Margin="0,0,15,0" VerticalAlignment="Center"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource HeaderTextBlockStyle}" Text="AskMe! クライアント" Margin="0"/>
                    <TextBlock FontSize="13" Foreground="#666666" 
                               Text="VRChatのログをリアルタイムで監視して、ワールド変更を検出します"/>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- コントロールパネル -->
        <views:StatusControl Grid.Row="1" Margin="0,0,0,15"/>

        <!-- Webアプリケーション連携設定 -->
        <views:ApiSettingsControl Grid.Row="2" Margin="0,0,0,15"/>

        <!-- 現在のインスタンス情報 -->
        <views:CurrentInstanceControl Grid.Row="3" Margin="0,0,0,15"/>

        <!-- 履歴 -->
        <views:HistoryControl Grid.Row="4"/>
    </Grid>
</Window>
