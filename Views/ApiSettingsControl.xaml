<UserControl x:Class="askMeWindows.Views.ApiSettingsControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:primitives="clr-namespace:System.Windows.Controls.Primitives;assembly=PresentationFramework"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="800">
    <Border Background="#EBF3FB" BorderBrush="#0078D4" BorderThickness="1" CornerRadius="8" Padding="15">
        <StackPanel>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Style="{StaticResource LabelTextBlockStyle}" Text="Webアプリケーション連携" Foreground="#0078D4" VerticalAlignment="Center"/>
                <Button Grid.Column="1" Content="AskMe! Webを開く" Click="AskMeWebButton_Click" Margin="10,0,0,0" Width="180" Height="30" HorizontalAlignment="Left" VerticalAlignment="Center">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border Background="White" BorderBrush="#0078D4" BorderThickness="1" CornerRadius="4" Cursor="Hand">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                        </ControlTemplate>
                    </Button.Template>
                    <Button.Resources>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="White"/>
                            <Setter Property="FontWeight" Value="Bold"/>
                        </Style>
                    </Button.Resources>
                </Button>
            </Grid>
            <Grid Margin="0,5,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="APIキー" Margin="0,0,0,5"/>
                    <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="4" Background="White" Width="300" HorizontalAlignment="Left">
                        <PasswordBox x:Name="ApiKeyBox" BorderThickness="0" Background="Transparent" Padding="5,3" Height="28" VerticalContentAlignment="Center" PasswordChanged="ApiKeyBox_PasswordChanged"/>
                    </Border>
                    <TextBlock FontSize="10" Foreground="#666666" Margin="0,5,0,0">
                        <Run Text="※連携先のWebサイトで発行されたAPIキーを入力してください。"/>
                        <LineBreak/>

                    </TextBlock>
                </StackPanel>

                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="20,0,0,0">
                    <TextBlock Style="{StaticResource LabelTextBlockStyle}" Text="プライバシー設定" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                    <ToggleButton IsChecked="{Binding IsLocationHidden}" Width="160" Height="40">
                        <ToggleButton.Style>
                            <Style TargetType="ToggleButton">
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="Foreground" Value="#0078D4"/>
                                <Setter Property="Content" Value="🔓 居場所を公開中"/>
                                <Setter Property="FontSize" Value="13"/>
                                <Setter Property="FontWeight" Value="Bold"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ToggleButton">
                                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding Foreground}" BorderThickness="1.5" CornerRadius="6" Cursor="Hand">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter Property="Background" Value="#FFF0F0"/>
                                        <Setter Property="Foreground" Value="#D13438"/>
                                        <Setter Property="Content" Value="🔒 居場所を隠ぺい中"/>
                                    </Trigger>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Opacity" Value="0.8"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ToggleButton.Style>
                    </ToggleButton>
                </StackPanel>
            </Grid>
        </StackPanel>
    </Border>
</UserControl>
